[Unit]
Description=Birthdate Telegram bot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/opt/birthdate-bot
EnvironmentFile=/opt/birthdate-bot/.env
ExecStart=/opt/birthdate-bot/venv/bin/python bot.py
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
