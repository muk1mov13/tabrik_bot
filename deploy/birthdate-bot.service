[Unit]
Description=Birthdate Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/opt/birthdate-bot
EnvironmentFile=/opt/birthdate-bot/.env
ExecStart=/opt/birthdate-bot/venv/bin/python -m birthday_bot
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/birthdate-bot/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
